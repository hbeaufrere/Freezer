# Copy to .env for local development. On Vercel, set these under
# Project Settings -> Environment Variables instead.

# Postgres connection string. Use the POOLED endpoint — serverless functions
# open far more short-lived connections than a direct connection can absorb.
# On Neon the pooled host contains "-pooler":
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require
# The Vercel Neon integration sets this for you; it also sets
# DATABASE_URL_UNPOOLED, which is the direct endpoint — don't use that one here.
DATABASE_URL=

# Signs session cookies. Generate with:
#   python -c 'import secrets; print(secrets.token_hex(32))'
# Changing it signs everyone out. There is no default: the app refuses to start
# without it, so a published fallback can never end up guarding real data.
SECRET_KEY=

# The shared lab password. Use something long and random.
FREEZER_PASSWORD=

# Optional: hours before a signed-in session expires (default 12).
SESSION_HOURS=12

# Optional: max pooled connections per function instance (default 4).
DB_POOL_MAX=4

# Set to "development" locally so session cookies work over plain HTTP.
# Leave unset in production.
# FLASK_ENV=development

# ------------------------------------------------------------
# Drop-off email alerts (optional)
# ------------------------------------------------------------
# With these set, an email goes out whenever somebody leaves samples at CRC or
# VMTH, saying how many were added and how many are now waiting at each site.
# Leave them blank and the app behaves exactly as it did before.
#
# For Gmail, SMTP_PASSWORD must be a 16-character App Password, not the
# account password — Google rejects plain passwords over SMTP. Create one at
# myaccount.google.com/apppasswords (needs 2-Step Verification switched on).
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=abcdefghijklmnop
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# Where the alerts go. Defaults to SMTP_USER.
# NOTIFY_EMAIL=you@gmail.com
# Envelope sender. Defaults to SMTP_USER; Gmail requires it to be that
# account or one of its verified aliases.
# SMTP_FROM=you@gmail.com
